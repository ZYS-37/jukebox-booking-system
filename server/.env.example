# Runtime
NODE_ENV=development
PORT=3001
CLIENT_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-a-random-32-byte-secret
JWT_EXPIRES_IN=1h

# PostgreSQL / Supabase. On Render, use the Supabase Session pooler URL.
DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:5432/postgres
DB_POOL_MAX=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# For production certificate verification, encode the Supabase CA certificate
# as a single base64 value and set DB_SSL=true.
DB_SSL_CA_BASE64=

# Email
EMAIL_DEV_MODE=true
RESEND_API_KEY=

# Google Calendar
ENABLE_GOOGLE_CALENDAR=false
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
APP_BASE_URL=http://localhost:3000

# Telegram and scheduled jobs
ENABLE_TELEGRAMBOT=false
TELEGRAMBOT_TOKEN=
ENABLE_SCHEDULE_JOBS=false
RUN_AUTO_RELEASE_ON_START=false
