# Runtime
NODE_ENV=development
PORT=3001
CLIENT_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-a-random-32-byte-secret
JWT_EXPIRES_IN=1h

# MySQL
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=jukebox
# Aiven / managed MySQL TLS. Paste its CA PEM as one base64 value, then leave
# DB_SSL_REJECT_UNAUTHORIZED=true to validate the server certificate.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_BASE64=

# Email
EMAIL_DEV_MODE=true
RESEND_API_KEY=

# Google Calendar
ENABLE_GOOGLE_CALENDAR=false
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
APP_BASE_URL=http://localhost:3000

# Telegram and scheduled jobs
ENABLE_TELEGRAMBOT=false
TELEGRAMBOT_TOKEN=
ENABLE_SCHEDULE_JOBS=false
RUN_AUTO_RELEASE_ON_START=false
